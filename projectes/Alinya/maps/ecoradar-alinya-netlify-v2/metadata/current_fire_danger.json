    "ndmi_dryness": {
      "kind": "dynamic",
      "full_weight_max_age_hours": 240,
      "exclude_after_hours": 720,
      "rationale": "Sentinel-2 pot oferir revisita aproximada de 5 dies, condicionada per núvols; més de 30 dies no descriu l'estat hídric actual."
    },
    "surface_temperature": {
      "kind": "dynamic",
      "full_weight_max_age_hours": 192,
      "exclude_after_hours": 576,
      "rationale": "Landsat 8/9 aporta una oportunitat combinada aproximada de 8 dies; entre 8 i 24 dies el pes disminueix i després s'exclou."
    },
    "vegetation_continuity": {
      "kind": "structural",
      "rationale": "La continuïtat horitzontal de coberta és una característica territorial de canvi lent."
    },
    "wind": {
      "kind": "dynamic",
      "full_weight_max_age_hours": 3,
      "exclude_after_hours": 24,
